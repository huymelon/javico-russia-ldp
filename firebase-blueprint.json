{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "displayName": { "type": "string", "description": "User's display name" },
        "photoURL": { "type": "string", "description": "User's profile picture URL" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "User's role in the system" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user profile was created" }
      },
      "required": ["uid", "email", "role"]
    },
    "Job": {
      "title": "Job",
      "description": "Job listing information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the job" },
        "title": { "type": "string", "description": "Job title" },
        "description": { "type": "string", "description": "Job description" },
        "category": { "type": "string", "description": "Job category" },
        "salary": { "type": "string", "description": "Salary range" },
        "location": { "type": "string", "description": "Job location" },
        "duration": { "type": "string", "description": "Contract duration" },
        "imageUrl": { "type": "string", "description": "Job image URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the job was posted" }
      },
      "required": ["title", "category", "salary", "location"]
    },
    "Application": {
      "title": "Application",
      "description": "Job application information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the application" },
        "jobId": { "type": "string", "description": "ID of the job being applied for" },
        "userId": { "type": "string", "description": "ID of the user applying" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "accepted", "rejected"], "description": "Application status" },
        "fullName": { "type": "string", "description": "Applicant's full name" },
        "phone": { "type": "string", "description": "Applicant's phone number" },
        "email": { "type": "string", "format": "email", "description": "Applicant's email" },
        "interest": { "type": "string", "description": "Applicant's area of interest" },
        "city": { "type": "string", "description": "Applicant's current city" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the application was submitted" }
      },
      "required": ["jobId", "userId", "fullName", "phone", "email", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles"
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Collection of job listings"
    },
    "/applications/{applicationId}": {
      "schema": "Application",
      "description": "Collection of job applications"
    }
  }
}
